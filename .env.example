# Required to sign in. Pick something you will type on your phone.
SITE_PASSWORD=study

# Optional. Falls back to SITE_PASSWORD if unset.
SESSION_SECRET=

# Production (Vercel): Neon connection string. Locally, PGlite in .data/ is used.
DATABASE_URL=

# Production: Vercel Blob. Locally, files are stored in .data/blob/.
BLOB_READ_WRITE_TOKEN=

# Optional. Vercel sets this automatically for scheduled Cron Job requests —
# set it yourself only if you want to call /api/cron/purge-trash manually.
CRON_SECRET=

# Gemini (server-side only). Next.js only loads this from .env.local / Vercel env —
# not from this example file. Cheapest default: gemini-3.5-flash-lite.
# Dump clustering, chat, and note cleanup stay on Flash-Lite (outlines only).
# Heavier math/code quizzes route to gemini-3.7-flash.
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Absolute path to your local SMU notes folder (not committed).
# Command palette → “Sync SMU notes” reads from here.
SMU_NOTES_DIR=/Users/matth/Documents/SMU

# Absolute path to your local Obsidian vault (not committed).
# Command palette → “Sync Obsidian notes” reads from here.
OBSIDIAN_VAULT_DIR=/Users/matth/Documents/Obsidian Vault
